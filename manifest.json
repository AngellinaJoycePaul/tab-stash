{
  "manifest_version": 3,
  "name": "Tab Stash",
  "version": "1.0.0",
  "description": "Group tabs by domain, stash them, restore later.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Stash"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "stash-active-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Stash the active tab"
    }
  }
}